# Copy to <stateDir>/oss.env (created by `vault-sync init`) and keep it at mode 0600.
# Never commit this file, never paste these values into a plugin config or a chat.
#
# Prefer a RAM sub-account restricted to: oss:PutObject, oss:GetObject,
# oss:ListObjects, oss:DeleteObject, oss:GetBucketLifecycle.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional: also settable in config.json under remote.*
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=
# Optional: use an existing rclone remote instead of the native client.
# DSH_VAULT_SYNC_RCLONE_REMOTE=aliyun-oss
